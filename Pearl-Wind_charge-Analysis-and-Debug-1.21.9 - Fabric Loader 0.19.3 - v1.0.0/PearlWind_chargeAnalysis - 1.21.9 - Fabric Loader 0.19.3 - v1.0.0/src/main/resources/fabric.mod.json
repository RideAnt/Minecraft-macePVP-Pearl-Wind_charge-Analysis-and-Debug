{
  "schemaVersion": 1,
  "id": "pearlwind_chargeanalysis",
  "version": "${version}",
  "name": "PearlWind_chargeAnalysis",
  "description": "Client-side ender-pearl and wind-charge trajectory analysis with P1/P2 tracking and configurable visual guides.",
  "authors": [
    "RideAnt"
  ],
  "license": "MIT",
  "icon": "assets/pearlwind_chargeanalysis/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.pearlwindchargeanalysis.PearlWindChargeAnalysisClient"
    ],
    "modmenu": [
      "com.example.pearlwindchargeanalysis.PearlWindChargeAnalysisModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": ">=0.134.1+1.21.9",
    "cloth-config": ">=20.0.149"
  },
  "suggests": {
    "modmenu": "*"
  },
  "mixins": [
    "pearlwind_chargeanalysis.client.mixins.json"
  ]
}
